# --- App ---
APP_ENV=local                 # local | ec2
API_PORT=8000

# --- LLM (교체 지점) ---
LLM_BACKEND=mock              # mock | llama_cpp
MODEL_PATH=./models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_N_CTX=2048
LLM_N_THREADS=2
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.3

# --- Retriever (교체 지점) ---
RETRIEVER_BACKEND=null        # null | bm25 | embedding | hybrid
SPEC_INDEX_PATH=./data/index/spec_bm25.pkl
DOC_INDEX_PATH=./data/index/docs_bm25.pkl
RETRIEVER_TOP_K=3

# --- Policy ---
RULES_PATH=./rules/safety_spec.yaml

# --- Storage ---
DB_PATH=./data/finguard.db
